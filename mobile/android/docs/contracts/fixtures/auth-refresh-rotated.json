{
  "request": {
    "method": "POST",
    "path": "/v1/auth/sessions:refresh",
    "body": {
      "refresh_token": "refresh-token-old"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "X-Request-ID": "req-refresh-rotated"
    },
    "body": {
      "access_token": "access-token-new",
      "refresh_token": "refresh-token-rotated",
      "token_type": "bearer",
      "expires_in": 900,
      "refresh_expires_in": 2592000
    }
  }
}
