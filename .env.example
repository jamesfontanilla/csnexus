# Copy to `.env` and fill in real values. Never commit `.env`.

# ── JWT ────────────────────────────────────────────────────────────────────
# MUST be a high-entropy random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
# Access tokens default to 15 minutes; refresh tokens default to 30 days.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ── Database ───────────────────────────────────────────────────────────────
# Local dev default (SQLite). In production, set this to your Supabase
# connection string (Session mode pooler, port 5432):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# IMPORTANT: Use the "Session mode" pooler URL from Supabase dashboard
# (Project Settings → Database → Connection pooling → Session mode).
# Do NOT use the direct connection URL in production — it bypasses the
# pooler and will exhaust connections on the free tier.
DATABASE_URL=sqlite:///data/cse.db

# ── Email (Brevo) ──────────────────────────────────────────────────────────
# Required for OTP and password-reset emails to reach real inboxes.
# 1. Sign up at https://brevo.com (free: 300 emails/day, ~9,000/month)
# 2. Verify your sending domain or sender email in Brevo dashboard
# 3. Go to Settings → SMTP & API → API Keys → Generate a new key
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "From" address shown to recipients. Must match your verified Brevo sender/domain.
# Format: "Display Name <address@yourdomain.com>"
EMAIL_FROM_ADDR=CSNexus <noreply@csnexus.space>

# ── OTP (offline fallback) ─────────────────────────────────────────────────
# Path to the offline OTP log file. Only used when BREVO_API_KEY is unset
# (local dev without email credentials).
OTP_OFFLINE_LOG_PATH=data/otp_offline.log

# ── Google OAuth ───────────────────────────────────────────────────────────
# Required for "Continue with Google" authentication.
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web application type)
# 3. Add http://localhost:8000 to Authorized JavaScript origins
# 4. Paste the Client ID here
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Application Environment ────────────────────────────────────────────────
# Controls security behaviour: CORS origins, HSTS header, etc.
# Set to "production" in deployed environments. Defaults to "development".
APP_ENV=development
