# Copy to `.env.android` before building the Android app.
#
# Android runs from a native WebView, so the API URL must be an absolute
# deployed backend URL. Do not leave this blank for release builds.
VITE_API_URL=https://your-csnexus-api.example.com

# Use the same web client ID only if the existing Google web sign-in flow works
# in the Android WebView. Otherwise add a native Android OAuth flow later.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
